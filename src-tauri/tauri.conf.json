{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "91Writing",
  "version": "2.8.0",
  "identifier": "com.writing91.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:7520",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
      "title": "91写作",
      "width": 480,
      "height": 800,
      "resizable": true,
      "fullscreen": false,
      "center": true,
      "minWidth": 360,
      "minHeight": 600,
      "maxWidth": 600,
      "maxHeight": 1200,
      "decorations": true,
      "transparent": false,
      "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
